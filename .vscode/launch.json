{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动机械臂仿真小组作业",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "5173",
        "--strictPort"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen",
      "outputCapture": "std",
      "env": {
        "NO_COLOR": "1"
      },
      "serverReadyAction": {
        "pattern": "(http://127\\.0\\.0\\.1:5173/)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
